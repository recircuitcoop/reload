{
  "name": "reload-node-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace root for the new Reload application (plan 0018), and the pin of the official Anytype MCP server.",
  "license": "MIT",
  "workspaces": [
    "app",
    "sdk/ts",
    "packages/*"
  ],
  "scripts": {
    "gate:install": "npm ci",
    "gate:types": "npm run --workspace app types",
    "gate:lint": "eslint . && prettier --check .",
    "gate:architecture": "npm run --workspace app architecture",
    "gate:licences": "node tools/licences.mjs",
    "gate:unit": "npm run --workspace app test:unit -- --reporter=default --reporter=json --outputFile.json=../.gate/vitest.json",
    "gate:conformance": "npm run --workspace app test:conformance",
    "gate:e2e": "npm run --workspace app test:e2e",
    "tool-surface:refresh": "esbuild tools/refresh-tool-surface/cli.ts --bundle --platform=node --target=node22 --format=cjs --outfile=node_modules/.cache/reload/refresh-tool-surface.cjs --log-level=warning --log-override:empty-import-meta=silent && node node_modules/.cache/reload/refresh-tool-surface.cjs app/src/adapters/anytype/tool_surface.json",
    "gate:parity": "tsc -p tools/parity && node tools/parity/check.ts --vitest .gate/vitest.json --playwright .gate/playwright.json --junit .gate/pytest-sdk.xml"
  },
  "dependencies": {
    "@anyproto/anytype-mcp": "1.2.10"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
