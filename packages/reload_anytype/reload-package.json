{
  "protocol": 2,
  "package": "reload_anytype",
  "version": "0.2.0",
  "environment": {
    "kind": "node",
    "node": ">=22"
  },
  "types": [
    {
      "id": "create-object",
      "kind": "node",
      "label": "Create Anytype object",
      "description": "Adds an object to Anytype for each item that reaches this step, in the space you choose: a page, or any other type the space has.",
      "icon": "font-awesome/fa-plus-square",
      "command": ["{node}", "{package}/dist/anytype.cjs"],
      "config": {
        "type": "object",
        "required": ["space_id"],
        "properties": {
          "space_id": {
            "type": "string",
            "title": "Space",
            "reload": {
              "spaces": true
            },
            "description": "The Anytype space each new object goes in."
          },
          "type_key": {
            "type": "string",
            "title": "Save as",
            "description": "What each new file becomes in Anytype.",
            "default": "page",
            "reload": {
              "types": {
                "of": "space_id"
              }
            }
          },
          "name_field": {
            "type": "string",
            "title": "Name from",
            "description": "Which part of what reaches this step names the object; \"Untitled\" when there is none. Most flows never change it.",
            "default": "/name",
            "reload": {
              "advanced": true
            }
          },
          "body_field": {
            "type": "string",
            "title": "Text from",
            "description": "Which part of what reaches this step fills the object; empty when there is none. Most flows never change it.",
            "default": "/body",
            "reload": {
              "advanced": true
            }
          },
          "api_base_url": {
            "type": "string",
            "title": "Anytype address",
            "description": "Where Reload reaches Anytype on this computer. Change it only if Anytype runs somewhere else.",
            "default": "http://127.0.0.1:31009",
            "reload": {
              "advanced": true
            }
          }
        }
      },
      "outputs": [
        {
          "port": "created",
          "event": "reload_anytype.object.created.v1"
        }
      ]
    },
    {
      "id": "update-object",
      "kind": "node",
      "label": "Update Anytype object",
      "description": "Changes properties of an object in Anytype, each from what reaches this step.",
      "icon": "font-awesome/fa-pencil-square-o",
      "command": ["{node}", "{package}/dist/anytype.cjs"],
      "config": {
        "type": "object",
        "required": ["space_id"],
        "properties": {
          "space_id": {
            "type": "string",
            "title": "Space",
            "reload": {
              "spaces": true
            },
            "description": "The Anytype space the object is in."
          },
          "object_id_field": {
            "type": "string",
            "title": "Object from",
            "description": "Which part of what reaches this step names the object. Most flows never change it.",
            "default": "/object_id",
            "reload": {
              "advanced": true
            }
          },
          "properties": {
            "type": "array",
            "title": "Properties",
            "items": {
              "type": "object",
              "required": ["key", "value_field"],
              "properties": {
                "key": {
                  "type": "string",
                  "title": "Property key"
                },
                "value_field": {
                  "type": "string",
                  "title": "Value from",
                  "description": "Which part of what reaches this step holds the value: text, a number or true/false."
                }
              }
            }
          },
          "api_base_url": {
            "type": "string",
            "title": "Anytype address",
            "description": "Where Reload reaches Anytype on this computer. Change it only if Anytype runs somewhere else.",
            "default": "http://127.0.0.1:31009",
            "reload": {
              "advanced": true
            }
          }
        }
      },
      "outputs": [
        {
          "port": "updated",
          "event": "reload_anytype.object.updated.v1"
        }
      ]
    },
    {
      "id": "read-object",
      "kind": "node",
      "label": "Read Anytype object",
      "description": "Reads an object from Anytype, with its properties, and passes it on.",
      "icon": "font-awesome/fa-file-text-o",
      "command": ["{node}", "{package}/dist/anytype.cjs"],
      "config": {
        "type": "object",
        "required": ["space_id"],
        "properties": {
          "space_id": {
            "type": "string",
            "title": "Space",
            "reload": {
              "spaces": true
            },
            "description": "The Anytype space the object is in."
          },
          "object_id_field": {
            "type": "string",
            "title": "Object from",
            "description": "Which part of what reaches this step names the object. Most flows never change it.",
            "default": "/object_id",
            "reload": {
              "advanced": true
            }
          },
          "api_base_url": {
            "type": "string",
            "title": "Anytype address",
            "description": "Where Reload reaches Anytype on this computer. Change it only if Anytype runs somewhere else.",
            "default": "http://127.0.0.1:31009",
            "reload": {
              "advanced": true
            }
          }
        }
      },
      "outputs": [
        {
          "port": "object",
          "event": "reload_anytype.object.read.v1"
        }
      ]
    },
    {
      "id": "read-space",
      "kind": "node",
      "label": "Read Anytype space",
      "description": "Lists the objects of an Anytype space, only those of one type if you choose one.",
      "icon": "font-awesome/fa-th-list",
      "command": ["{node}", "{package}/dist/anytype.cjs"],
      "config": {
        "type": "object",
        "required": ["space_id"],
        "properties": {
          "space_id": {
            "type": "string",
            "title": "Space",
            "reload": {
              "spaces": true
            },
            "description": "The Anytype space to list."
          },
          "type_filter": {
            "type": "string",
            "title": "Only objects of type",
            "description": "Empty for every type.",
            "reload": {
              "types": {
                "of": "space_id"
              }
            }
          },
          "limit": {
            "type": "integer",
            "title": "At most",
            "minimum": 1,
            "maximum": 1000,
            "default": 50
          },
          "api_base_url": {
            "type": "string",
            "title": "Anytype address",
            "description": "Where Reload reaches Anytype on this computer. Change it only if Anytype runs somewhere else.",
            "default": "http://127.0.0.1:31009",
            "reload": {
              "advanced": true
            }
          }
        }
      },
      "outputs": [
        {
          "port": "objects",
          "event": "reload_anytype.space.read.v1"
        }
      ]
    },
    {
      "id": "search",
      "kind": "node",
      "label": "Search Anytype",
      "description": "Searches Anytype, in one space or in all of them, for the words set here or the words that reach this step.",
      "icon": "font-awesome/fa-search",
      "command": ["{node}", "{package}/dist/anytype.cjs"],
      "config": {
        "type": "object",
        "properties": {
          "space_id": {
            "type": "string",
            "title": "Space",
            "reload": {
              "spaces": true
            },
            "description": "Empty to search every space."
          },
          "query": {
            "type": "string",
            "title": "Search for"
          },
          "query_field": {
            "type": "string",
            "title": "Search for what reaches this step",
            "description": "Which part of what reaches this step holds the words; used instead of Search for when set.",
            "reload": {
              "advanced": true
            }
          },
          "types": {
            "type": "array",
            "title": "Only types",
            "items": {
              "type": "string"
            }
          },
          "limit": {
            "type": "integer",
            "title": "At most",
            "minimum": 1,
            "maximum": 1000,
            "default": 20
          },
          "api_base_url": {
            "type": "string",
            "title": "Anytype address",
            "description": "Where Reload reaches Anytype on this computer. Change it only if Anytype runs somewhere else.",
            "default": "http://127.0.0.1:31009",
            "reload": {
              "advanced": true
            }
          }
        }
      },
      "outputs": [
        {
          "port": "results",
          "event": "reload_anytype.search.results.v1"
        }
      ]
    }
  ]
}
